# ── Storage ──────────────────────────────────────────────────────────────────
# Directory where videos, audio, thumbnails, and the database are stored.
STORAGE_ROOT=storage

# SQLite database path (must be inside STORAGE_ROOT for Docker volume mounts).
DATABASE_URL=sqlite+aiosqlite:///storage/hamstr.db

# ── Workers ───────────────────────────────────────────────────────────────────
# Number of parallel download workers (each worker handles one video at a time).
DOWNLOAD_WORKERS=1

# Maximum number of ffmpeg processes that may run simultaneously.
MAX_CONCURRENT_FFMPEG=2

# ── Site logins (age-restricted, members-only, subscriber content) ───────────
# Signing the archive in to a site is done from the app: Settings → Site logins,
# driven by the Firefox extension. The resulting cookie jars live in
# STORAGE_ROOT/cookies/ and are merged into cookies/merged.txt for yt-dlp.
#
# Those routes hold live sessions, so they are the only part of the API behind a
# token. Unset means the feature is disabled, never that it is open.
#
#   ADMIN_TOKEN=$(openssl rand -hex 32)
#
# ADMIN_TOKEN=

# Manual override: point yt-dlp at a cookies file you manage yourself instead of
# the one the app maintains. Only needed if you prefer the old workflow:
#   yt-dlp --cookies-from-browser firefox --cookies storage/cookies.txt <any-url>
# Docker: the file must be inside the storage bind-mount.
#
# YT_COOKIES_FILE=storage/cookies.txt

# ── Logging ───────────────────────────────────────────────────────────────────
# Uvicorn log level: debug | info | warning | error | critical
# LOG_LEVEL=info
